{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "incipit",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "incipit.cli",
        "review",
        "--db",
        "data/incipit.db",
        "--bucket-uri",
        "file://./data/bucket",
        "--host",
        "127.0.0.1",
        "--port",
        "8011"
      ],
      "port": 8011,
      "autoPort": false
    }
  ]
}
