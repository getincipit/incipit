# A client's install keeps its settings in incipit.toml inside the data folder; this file is for a
# developer's checkout, and each variable below overrides one value of that file when it is set.
# INCIPIT_DATA_DIR=C:\Users\you\Documents\Incipit
# INCIPIT_PORT=8010

OPENROUTER_API_KEY=sk-or-v1-...

# Read by `incipit init --owner NAME` and `incipit create-owner`, so the owner's password is never
# typed into a shell history. Delete the file once the command has run.
# INCIPIT_OWNER_PASSWORD_FILE=C:\path\to\owner-password.txt

# Where verified database snapshots are written while the server runs. Empty means NO BACKUPS, and
# the server says so at startup. Must be a local disk that is always reachable.
# INCIPIT_BACKUP_DIR=D:\IncipitBackups

# Optional offsite copy of the backup set, typically a network share; best effort.
# INCIPIT_BACKUP_MIRROR=\server\share\IncipitBackups
